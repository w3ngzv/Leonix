menu "Device Drivers"

config EEPROM_LXFS
	def_bool AVR
	help
	  lxfs on the ATmega32U4's EEPROM, in drivers/eeprom.c.

config FLASH_LXFS
	def_bool ARM
	help
	  lxfs on the last pages of the STM32F103's Flash, in
	  drivers/stm32_flash.c.

config I2C
	bool "I2C bus master"
	depends on AVR
	help
	  The ATmega32U4's two-wire interface as an I2C bus master, on D2
	  (SDA) and D3 (SCL), in arch/avr/i2c.c.  Only the HD44780 display
	  uses it.

config HD44780
	bool "HD44780 character LCD on a PCF8574 backpack"
	depends on I2C
	help
	  A 16x2 HD44780 display behind a PCF8574 I2C expander.  A task
	  shows the idle share and the uptime on it once a second, and
	  panic() writes its reason there.

	  Without it the same task only reports stack usage to the kernel
	  log.

config SWD
	bool "Serial Wire Debug host"
	depends on AVR
	help
	  An SWD host on D8 (SWCLK) and D9 (SWDIO), for reading the
	  identification registers of an STM32F1 through /dev/swd.

config SWD_DAP
	bool "/dev/dap: target memory and run control"
	depends on SWD
	help
	  Memory reads and writes, halt, run and reset of the target, one
	  command per line written to /dev/dap, for a script on the host.
	  Also measures a square wave on D13 with Timer3.

config TTP229
	bool "TTP229 touch keypad"
	depends on AVR
	help
	  A TTP229 16-key capacitive keypad, such as the HW-136 board, on
	  A0 (SCL) and A1 (SDO), as /dev/keypad.  Each read returns one
	  character per key touched, '1' to '9' and 'a' to 'g' for keys 1
	  to 16.  The board must be set to 16-key mode, P1 pin 3 shorted.

endmenu
