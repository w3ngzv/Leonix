#
# The architecture is chosen here and kept in .config, as in U-Boot,
# rather than passed as ARCH= on every make as in Linux.  The Makefile
# reads SYS_ARCH from include/config/auto.conf.
#
# 架构在此选择并保存在 .config 中, 与 U-Boot 相同, 不像 Linux 那样每次 make
# 都以 ARCH= 传入. Makefile 从 include/config/auto.conf 读取 SYS_ARCH.
#
choice
	prompt "Architecture"
	default AVR

config AVR
	bool "AVR: Arduino Leonardo (ATmega32U4)"
	help
	  Leonix runs on the ATmega32U4 of the Arduino Leonardo, behind the
	  Caterina bootloader.

config ARM
	bool "ARM: STM32F103 (Cortex-M3)"
	help
	  Leonix runs on an STM32F103C8 such as the Blue Pill, from the
	  start of its Flash, with USART1 on PA9 and PA10 as the console.

endchoice

config SYS_ARCH
	string
	default "avr" if AVR
	default "arm" if ARM
	help
	  The directory under arch/ that the kernel is built from.

config INIT_CONSOLE
	string "Terminal that init opens for /bin/sh"
	default "ttyACM0" if AVR
	default "ttyS0" if ARM
	help
	  The name in /dev of the terminal that becomes standard input
	  and output of /bin/sh.

source "arch/avr/Kconfig"
source "arch/arm/Kconfig"
