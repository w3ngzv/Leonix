#
# The architecture is ARCH= on the make command line, or in the
# environment, as in Linux; the Makefile exports SRCARCH.  As Linux's
# arch/Kconfig, this file reads arch/$(SRCARCH)/Kconfig first, so that
# the options below can depend on what it defines.
#
# 架构与 Linux 相同, 由 make 命令行或环境变量中的 ARCH= 给出, Makefile 导出
# SRCARCH. 与 Linux 的 arch/Kconfig 相同, 本文件先读取
# arch/$(SRCARCH)/Kconfig, 下面的选项因此可以依赖其中定义的符号.
#
source "arch/$(SRCARCH)/Kconfig"

config INIT_CONSOLE
	string "Terminal that init opens for /bin/sh"
	default "ttyACM0" if AVR
	default "ttyS0" if ARM
	help
	  The name in /dev of the terminal that becomes standard input
	  and output of /bin/sh.
