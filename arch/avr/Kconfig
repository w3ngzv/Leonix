config AVR
	def_bool y
	help
	  Leonix runs on the ATmega32U4 of the Arduino Leonardo, behind the
	  Caterina bootloader.

config USB_CDC_ACM
	def_bool y
	help
	  The ATmega32U4's USB controller as a CDC-ACM serial port, in
	  arch/avr/usb.c.  It carries ttyACM0 and the kernel log.
