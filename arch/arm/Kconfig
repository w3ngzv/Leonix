config ARM
	def_bool y
	help
	  Leonix runs on an STM32F103C8 such as the Blue Pill, from the
	  start of its Flash, with USART1 on PA9 and PA10 as the console.

config USART_CONSOLE
	def_bool y
	help
	  USART1 of the STM32F103 at 115200 baud, on PA9 (TX) and PA10
	  (RX), in arch/arm/usart.c.  It carries ttyS0 and the kernel log.
